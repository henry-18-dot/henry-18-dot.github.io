# Copy to .env.local for local API development. Do not commit .env.local.
DEEPSEEK_API_KEY=
# Local only: a random code of at least 24 characters.
LOCAL_ACCESS_CODE=
# Production: SHA-256 hex of the personal access code. Never expose the raw code.
TOKEN_HASH=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
DAILY_BUDGET_CNY=1
MONTHLY_BUDGET_CNY=10
# Peak CNY prices / 1 million tokens, official pricing checked 2026-10-11.
FLASH_INPUT_CNY_PER_M=2
FLASH_OUTPUT_CNY_PER_M=8
FLASH_CACHE_CNY_PER_M=0.04
PRO_INPUT_CNY_PER_M=9
PRO_OUTPUT_CNY_PER_M=27
PRO_CACHE_CNY_PER_M=0.30
